<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local database containing sensitive password hashes, sessions, business data, and transactions from Google Drive / Cloud Backup -->
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude local database containing sensitive data from unencrypted transfer -->
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
